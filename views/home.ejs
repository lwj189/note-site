<%- include('header', { heading: '首页', current: typeof current !== 'undefined' ? current : 'home' }) %>

<div class="home-hero">
  <h1>欢迎使用 MyNote</h1>
  <p>一个简洁的笔记管理工具，支持 Markdown 编辑、代码高亮、图片管理。</p>
  <a href="/new" class="btn">+ 新建笔记</a>
</div>

<% if (notes.length > 0) { %>
<div class="home-section">
  <h2>最近笔记</h2>
  <div class="home-recent-grid">
    <% notes.slice(0, 9).forEach(n => { %>
    <div class="home-recent-card" data-slug="<%= n.slug %>">
      <div class="card-actions">
        <a href="/edit/<%= encodeURIComponent(n.slug) %>" class="card-action-btn card-edit" title="编辑" onclick="event.stopPropagation()">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        </a>
        <button class="card-action-btn card-del" title="删除" onclick="event.stopPropagation(); delNoteCard(this, '<%= n.slug %>')">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
        </button>
      </div>
      <a href="/note/<%= encodeURIComponent(n.slug) %>" class="home-recent-card-link">
        <h3><%= n.title %> <span class="badge"><%= n.type %></span></h3>
        <div class="meta"><%= new Date(n.updatedAt).toLocaleDateString('zh-CN') %></div>
        <% if (n.tags && n.tags.length) { %>
        <div class="tag-list">
          <% n.tags.forEach(t => { %>
          <a href="/notebook/<%= encodeURIComponent(t) %>" class="tag-badge" onclick="event.stopPropagation()"><%= t %></a>
          <% }) %>
        </div>
        <% } %>
        <div class="preview"><%= n.content.replace(/[#*`\[\]!>]/g, '').substring(0, 100) %></div>
      </a>
    </div>
    <% }) %>
  </div>
  <% if (notes.length > 9) { %>
  <a href="/list" style="display:inline-block;margin-top:14px;color:var(--accent);font-size:.9rem;text-decoration:none">查看全部 <%= notes.length %> 篇笔记 →</a>
  <% } %>
</div>
<% } else { %>
<div class="empty" style="padding:60px 20px">
  <div style="font-size:3rem;margin-bottom:12px">📝</div>
  <p style="font-size:1.1rem;font-weight:600;margin-bottom:4px">还没有笔记</p>
  <p style="color:var(--muted);margin-bottom:20px;font-size:.9rem">点击下方按钮创建你的第一篇笔记</p>
  <div style="margin-top:28px;display:flex;gap:24px;justify-content:center;flex-wrap:wrap">
    <div style="font-size:.82rem;color:var(--muted);text-align:center"><span style="font-size:1.5rem;display:block;margin-bottom:4px">📝</span>支持 Markdown</div>
    <div style="font-size:.82rem;color:var(--muted);text-align:center"><span style="font-size:1.5rem;display:block;margin-bottom:4px">📁</span>笔记本分类</div>
    <div style="font-size:.82rem;color:var(--muted);text-align:center"><span style="font-size:1.5rem;display:block;margin-bottom:4px">🖼️</span>插入图片</div>
    <div style="font-size:.82rem;color:var(--muted);text-align:center"><span style="font-size:1.5rem;display:block;margin-bottom:4px">🔍</span>全文搜索</div>
  </div>
</div>
<% } %>


<div style="position:fixed;bottom:24px;right:24px;z-index:50">
  <button id="shortcut-btn" style="width:40px;height:40px;border:none;border-radius:50%;background:var(--accent);color:#fff;font-size:1.1rem;cursor:pointer;box-shadow:0 2px 10px rgba(67,97,238,.3)" title="快捷键">⌨</button>
</div>
<div id="shortcut-modal" style="display:none;position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:24px;z-index:200;box-shadow:0 8px 40px rgba(0,0,0,.15);max-width:360px;width:90%">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
    <h2 style="font-size:1.1rem;margin:0">⌨ 快捷键</h2>
    <button onclick="closeShortcut()" style="border:none;background:none;font-size:1.3rem;cursor:pointer;color:var(--muted)">&times;</button>
  </div>
  <div style="display:grid;grid-template-columns:auto 1fr;gap:8px 16px;font-size:.85rem">
    <kbd style="background:#f1f5f9;padding:2px 8px;border-radius:4px;border:1px solid var(--border);font-family:inherit">Ctrl+K</kbd><span>搜索笔记</span>
    <kbd style="background:#f1f5f9;padding:2px 8px;border-radius:4px;border:1px solid var(--border);font-family:inherit">Ctrl+N</kbd><span>新建笔记</span>
    <kbd style="background:#f1f5f9;padding:2px 8px;border-radius:4px;border:1px solid var(--border);font-family:inherit">Ctrl+B</kbd><span>加粗(编辑器)</span>
    <kbd style="background:#f1f5f9;padding:2px 8px;border-radius:4px;border:1px solid var(--border);font-family:inherit">Ctrl+I</kbd><span>斜体(编辑器)</span>
    <kbd style="background:#f1f5f9;padding:2px 8px;border-radius:4px;border:1px solid var(--border);font-family:inherit">Ctrl+Shift+P</kbd><span>切换预览</span>
    <kbd style="background:#f1f5f9;padding:2px 8px;border-radius:4px;border:1px solid var(--border);font-family:inherit">Ctrl+S</kbd><span>保存笔记</span>
  </div>
</div>
<div id="shortcut-overlay" onclick="closeShortcut()" style="display:none;position:fixed;inset:0;z-index:199;background:rgba(0,0,0,.3)"></div>
<script>
function closeShortcut(){document.getElementById("shortcut-modal").style.display="none";document.getElementById("shortcut-overlay").style.display="none"}
document.getElementById("shortcut-btn").onclick=function(){document.getElementById("shortcut-modal").style.display="block";document.getElementById("shortcut-overlay").style.display="block"};
</script>
<%- include('footer') %>
