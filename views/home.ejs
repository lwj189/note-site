<%- include('header', { heading: '首页' }) %>

<form class="search-bar" action="/search" method="get">
  <input type="text" name="q" placeholder="搜索笔记..." value="<%= query %>" autofocus>
  <button type="submit">搜索</button>
</form>

<details id="admin-panel">
  <summary class="admin-toggle">管理笔记</summary>
  <div class="admin-inner">
    <div class="admin-toolbar">
      <a href="/new" class="btn" style="margin-top:0">+ 新建笔记</a>
    </div>
    <div class="manage-section">
      <h3>所有笔记 (<%= notes.length %>)</h3>
      <% if (notes.length === 0) { %>
      <p style="color:var(--muted)">还没有笔记，点击上方按钮创建第一篇。</p>
      <% } else { %>
      <div class="manage-list">
        <% notes.forEach(n => { %>
        <div class="manage-item">
          <div>
            <strong><%= n.title %></strong>
            <span class="badge"><%= n.type %></span>
            <span style="font-size:.78rem;color:var(--muted);margin-left:8px">/note/<%= n.slug %></span>
          </div>
          <div class="actions">
            <a href="/note/<%= encodeURIComponent(n.slug) %>" class="btn btn-sm btn-outline" target="_blank">查看</a>
            <a href="/edit/<%= encodeURIComponent(n.slug) %>" class="btn btn-sm btn-outline">编辑</a>
            <button class="btn btn-sm btn-danger" onclick="delNote('<%= n.slug %>')">删除</button>
          </div>
        </div>
        <% }) %>
      </div>
      <% } %>
    </div>
  </div>
</details>

<% if (notes.length === 0) { %>
<div class="empty"><p>还没有笔记。</p></div>
<% } else { %>
<div class="note-list">
  <% notes.forEach(n => { %>
  <a href="/note/<%= encodeURIComponent(n.slug) %>" class="note-card">
    <h3><%= n.title %> <span class="badge"><%= n.type %></span></h3>
    <div class="meta"><%= new Date(n.updatedAt).toLocaleDateString('zh-CN') %></div>
    <div class="preview"><%= n.content.replace(/[#*`\[\]!>]/g, '').substring(0, 120) %></div>
  </a>
  <% }) %>
</div>
<% } %>

<script>
async function delNote(slug) {
  if (!confirm('确定删除笔记 "' + slug + '" 吗？此操作不可恢复。')) return;
  try {
    const res = await fetch('/api/notes/' + encodeURIComponent(slug), { method: 'DELETE' });
    const data = await res.json();
    if (data.ok) location.reload();
    else alert('删除失败：' + data.error);
  } catch (err) {
    alert('删除失败：' + err.message);
  }
}
</script>

<%- include('footer') %>
