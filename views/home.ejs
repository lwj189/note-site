<%- include('header', { heading: '首页', current: typeof current !== 'undefined' ? current : 'home' }) %>

<div class="home-hero">
  <h1>欢迎使用 MyNote</h1>
  <p>一个简洁的笔记管理工具，支持 Markdown 编辑、代码高亮、图片管理。</p>
  <a href="/new" class="btn">+ 新建笔记</a>
</div>

<% if (notes.length > 0) { %>
<div class="home-section">
  <h2>最近笔记</h2>
  <div class="home-recent-grid">
    <% notes.slice(0, 9).forEach(n => { %>
    <div class="home-recent-card" data-slug="<%= n.slug %>">
      <div class="card-actions">
        <a href="/edit/<%= encodeURIComponent(n.slug) %>" class="card-action-btn card-edit" title="编辑" onclick="event.stopPropagation()">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        </a>
        <button class="card-action-btn card-del" title="删除" onclick="event.stopPropagation(); delNoteCard(this, '<%= n.slug %>')">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
        </button>
      </div>
      <a href="/note/<%= encodeURIComponent(n.slug) %>" class="home-recent-card-link">
        <h3><%= n.title %> <span class="badge"><%= n.type %></span></h3>
        <div class="meta"><%= new Date(n.updatedAt).toLocaleDateString('zh-CN') %></div>
        <div class="preview"><%= n.content.replace(/[#*`\[\]!>]/g, '').substring(0, 100) %></div>
      </a>
    </div>
    <% }) %>
  </div>
  <% if (notes.length > 9) { %>
  <a href="/list" style="display:inline-block;margin-top:14px;color:var(--accent);font-size:.9rem;text-decoration:none">查看全部 <%= notes.length %> 篇笔记 →</a>
  <% } %>
</div>
<% } else { %>
<div class="empty"><p>还没有笔记，点击上方按钮创建第一篇。</p></div>
<% } %>

<%- include('footer') %>
