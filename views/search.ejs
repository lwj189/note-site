<%- include('header', { heading: '搜索', current: typeof current !== 'undefined' ? current : 'search' }) %>

<div class="search-header">
  <h1>搜索结果</h1>
  <% if (query) { %>
  <p>搜索 "<strong><%= query %></strong>" 找到 <%= notes.length %> 篇笔记</p>
  <% } else { %>
  <p>输入关键词搜索笔记标题和内容。</p>
  <% } %>
</div>

<% if (query && notes.length === 0) { %>
<div class="empty"><p>没有找到匹配的笔记。</p></div>
<% } else if (notes.length > 0) { %>
<div class="note-list">
  <% notes.forEach(n => { %>
  <a href="/note/<%= encodeURIComponent(n.slug) %>" class="note-card">
    <h3><%= n.title %> <span class="badge"><%= n.type %></span></h3>
    <div class="meta"><%= new Date(n.updatedAt).toLocaleDateString('zh-CN') %></div>
    <div class="preview"><%= n.content.replace(/[#*`\[\]!>]/g, '').substring(0, 120) %></div>
  </a>
  <% }) %>
</div>
<% } %>

<%- include('footer') %>
