<%- include('header', { heading: '全部笔记', current: typeof current !== 'undefined' ? current : '' }) %>

<div class="list-header">
  <h1>全部笔记</h1>
  <p>共 <%= notes.length %> 篇笔记，按更新时间排序</p>
</div>

<% if (typeof notebooks !== 'undefined' && notebooks.length > 0) { %>
<% } %>

<% if (notes.length === 0) { %>
<div class="empty"><p>还没有笔记。<a href="/new">创建第一篇</a></p></div>
<% } else { %>
<div class="note-list">
  <% notes.forEach(n => { %>
  <div class="note-card" data-slug="<%= n.slug %>">
    <a href="/note/<%= encodeURIComponent(n.slug) %>" class="note-card-link">
      <h3><% if (n.pinned) { %><span title="已置顶">📌</span> <% } %><%= n.title %> <span class="badge"><%= n.type %></span></h3>
      <div class="meta"><%= new Date(n.updatedAt).toLocaleDateString('zh-CN') %> &middot; /note/<%= n.slug %></div>
      <% if (n.tags && n.tags.length) { %>
      <div class="tag-list">
        <% n.tags.forEach(t => { %>
        <a href="/notebook/<%= encodeURIComponent(t) %>" class="tag-badge" onclick="event.stopPropagation()"><%= t %></a>
        <% }) %>
      </div>
      <% } %>
    </a>
    <div class="card-actions card-actions-inline">
      <button class="card-action-btn card-pin-btn<%= n.pinned ? ' pinned' : '' %>" title="置顶/取消置顶" onclick="event.stopPropagation(); togglePinCard(this, '<%= n.slug %>')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      </button>
      <a href="/edit/<%= encodeURIComponent(n.slug) %>" class="card-action-btn card-edit" title="编辑" onclick="event.stopPropagation()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      </a>
      <button class="card-action-btn card-del" title="删除" onclick="event.stopPropagation(); delNoteCard(this, '<%= n.slug %>')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
      </button>
    </div>
  </div>
  <% }) %>
</div>
<div id="batch-bar" style="display:none;padding:12px 16px;background:var(--card-bg);border:1px solid var(--border);border-radius:8px;margin-top:12px;align-items:center;gap:12px;max-width:900px">
  <span id="batch-count" style="font-size:.85rem;color:var(--muted)">已选 0 篇</span>
  <button class="btn btn-sm" onclick="batchDelete()" style="margin:0">批量删除</button>
  <button class="btn btn-sm btn-outline" onclick="batchClear()" style="margin:0">取消选择</button>
</div>
<script>
var batchSlugs=[];
function updateBatchBar(){var c=document.querySelectorAll(".batch-check:checked");batchSlugs=[];c.forEach(function(x){batchSlugs.push(x.dataset.slug)});var bar=document.getElementById("batch-bar");if(bar){if(batchSlugs.length){bar.style.display="flex";bar.style.alignItems="center";document.getElementById("batch-count").textContent="已选 "+batchSlugs.length+" 篇"}else{bar.style.display="none"}}}
function batchDelete(){if(!batchSlugs.length)return;if(!confirm("确定删除选中的 "+batchSlugs.length+" 篇笔记？"))return;var p=[];batchSlugs.forEach(function(s){p.push(fetch("/api/notes/"+encodeURIComponent(s),{method:"DELETE"}).then(function(r){return r.json()}))});Promise.all(p).then(function(){window.location.reload()})}
function batchClear(){document.querySelectorAll(".batch-check:checked").forEach(function(x){x.checked=false});updateBatchBar()}
</script>
<% } %>

<%- include('footer') %>
