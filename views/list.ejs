<%- include('header', { heading: '全部笔记', current: typeof current !== 'undefined' ? current : '' }) %>

<div class="list-header">
  <div class="list-header-main">
    <h1>全部笔记</h1>
    <p>共 <%= notes.length %> 篇笔记，按更新时间排序</p>
  </div>
  <button id="sel-mode-btn" class="btn btn-sm btn-outline" onclick="toggleSelectMode()">批量操作</button>
</div>

<% if (notes.length === 0) { %>
<div class="empty"><p>还没有笔记。<a href="/new">创建第一篇</a></p></div>
<% } else { %>
<div class="note-list">
  <% notes.forEach(n => { %>
  <div class="note-card" data-slug="<%= n.slug %>">
    <input type="checkbox" class="batch-check" data-slug="<%= n.slug %>" aria-label="选择这篇笔记">
    <a href="/note/<%= encodeURIComponent(n.slug) %>" class="note-card-link">
      <h3><% if (n.pinned) { %><span title="已置顶">📌</span> <% } %><%= n.title %> <span class="badge"><%= n.type %></span></h3>
      <div class="meta"><%= new Date(n.updatedAt).toLocaleDateString('zh-CN') %> &middot; /note/<%= n.slug %></div>
      <% if (n.tags && n.tags.length) { %>
      <div class="tag-list">
        <% n.tags.forEach(t => { %>
        <a href="/notebook/<%= encodeURIComponent(t) %>" class="tag-badge" onclick="event.stopPropagation()"><%= t %></a>
        <% }) %>
      </div>
      <% } %>
    </a>
    <div class="card-actions card-actions-inline">
      <button class="card-action-btn card-pin-btn<%= n.pinned ? ' pinned' : '' %>" title="置顶/取消置顶" onclick="event.stopPropagation(); togglePinCard(this, '<%= n.slug %>')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      </button>
      <a href="/edit/<%= encodeURIComponent(n.slug) %>" class="card-action-btn card-edit" title="编辑" onclick="event.stopPropagation()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      </a>
      <button class="card-action-btn card-del" title="删除" onclick="event.stopPropagation(); delNoteCard(this, '<%= n.slug %>')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
      </button>
    </div>
  </div>
  <% }) %>
</div>

<div id="batch-bar" class="batch-bar" style="display:none">
  <span id="batch-count">已选 0 篇</span>
  <button class="btn btn-sm" onclick="batchTag()">打标签</button>
  <button class="btn btn-sm" onclick="batchNotebook()">换笔记本</button>
  <button class="btn btn-sm btn-danger" onclick="batchDelete()">删除</button>
  <button class="btn btn-sm btn-outline" onclick="batchSelectAll()">全选</button>
  <button class="btn btn-sm btn-outline" onclick="batchClear()">取消选择</button>
</div>

<script src="/ui-dialog.js"></script>
<script>
(function () {
  var selectMode = false;
  var bar = document.getElementById('batch-bar');
  var modeBtn = document.getElementById('sel-mode-btn');

  function checks() { return Array.prototype.slice.call(document.querySelectorAll('.batch-check')); }
  function selectedSlugs() { return checks().filter(function (c) { return c.checked; }).map(function (c) { return c.dataset.slug; }); }

  function updateBatchBar() {
    var slugs = selectedSlugs();
    bar.style.display = (selectMode && slugs.length) ? 'flex' : 'none';
    document.getElementById('batch-count').textContent = '已选 ' + slugs.length + ' 篇';
    checks().forEach(function (c) {
      var card = c.closest('.note-card');
      if (card) card.classList.toggle('selected', c.checked);
    });
  }

  window.toggleSelectMode = function (on) {
    selectMode = (typeof on === 'boolean') ? on : !selectMode;
    document.body.classList.toggle('select-mode', selectMode);
    modeBtn.classList.toggle('active', selectMode);
    modeBtn.textContent = selectMode ? '退出批量' : '批量操作';
    if (!selectMode) { checks().forEach(function (c) { c.checked = false; }); }
    updateBatchBar();
  };

  checks().forEach(function (c) {
    c.addEventListener('change', updateBatchBar);
    var card = c.closest('.note-card');
    if (!card) return;
    card.addEventListener('click', function (e) {
      if (!selectMode) return;
      if (e.target.closest('.card-actions')) return;
      e.preventDefault();
      e.stopPropagation();
      c.checked = !c.checked;
      updateBatchBar();
    }, true);
  });

  window.batchSelectAll = function () { checks().forEach(function (c) { c.checked = true; }); updateBatchBar(); };
  window.batchClear = function () { checks().forEach(function (c) { c.checked = false; }); updateBatchBar(); };

  function postJSON(url, body) {
    return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
      .then(function (r) { return r.json().then(function (j) { if (!r.ok) throw new Error(j.error || '操作失败'); return j; }); });
  }

  window.batchTag = function () {
    var slugs = selectedSlugs();
    if (!slugs.length) return;
    uiPrompt({
      title: '批量打标签',
      message: '给选中的 ' + slugs.length + ' 篇笔记添加标签（多个用逗号分隔，已有标签不会重复）。',
      placeholder: '例如：C++，多线程',
      okText: '添加'
    }).then(function (input) {
      if (input === null) return;
      var tags = input.split(/[,，]/).map(function (s) { return s.trim(); }).filter(Boolean);
      if (!tags.length) return;
      return postJSON('/api/notes/batch', { slugs: slugs, action: 'tag', tags: tags })
        .then(function () { location.reload(); })
        .catch(function (err) { uiAlert(err.message); });
    });
  };

  window.batchNotebook = function () {
    var slugs = selectedSlugs();
    if (!slugs.length) return;
    fetch('/api/notebooks').then(function (r) { return r.json(); }).then(function (list) {
      var options = list.map(function (n) {
        return { label: '📁 ' + n.name + (typeof n.count === 'number' ? '（' + n.count + ' 篇）' : ''), value: n.name };
      });
      options.push({ label: '🚫 移出所有笔记本', value: '' });
      return uiSelect({
        title: '换笔记本',
        message: '把选中的 ' + slugs.length + ' 篇笔记移到：',
        options: options
      }).then(function (target) {
        if (target === null) return;
        return postJSON('/api/notes/batch', { slugs: slugs, action: 'notebook', notebook: target })
          .then(function () { location.reload(); })
          .catch(function (err) { uiAlert(err.message); });
      });
    });
  };

  window.batchDelete = function () {
    var slugs = selectedSlugs();
    if (!slugs.length) return;
    uiConfirm({
      title: '批量删除',
      message: '把选中的 ' + slugs.length + ' 篇笔记移到回收站？\n（之后可以在回收站还原）',
      okText: '移到回收站',
      danger: true
    }).then(function (yes) {
      if (!yes) return;
      return postJSON('/api/notes/batch', { slugs: slugs, action: 'delete' })
        .then(function () { location.reload(); })
        .catch(function (err) { uiAlert(err.message); });
    });
  };
})();
</script>
<% } %>

<%- include('footer') %>
