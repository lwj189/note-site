<%- include('header', { heading: '笔记本: ' + notebook, current: 'notebook' }) %>

<div class="list-header">
  <div class="list-header-row">
    <h1>📁 <%= notebook %></h1>
    <button class="card-action-btn" title="设置" onclick="editNotebookMeta('<%= notebook %>')" style="opacity:1;width:auto;padding:7px 12px;gap:6px;font-size:.85rem;font-family:inherit;font-weight:500">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
      <span>设置</span>
    </button>
  </div>
  <p>共 <%= notes.length %> 篇笔记</p>
</div>

<script>
async function editNotebookMeta(name) {
  // Fetch notes not in this notebook
  var allRes = await fetch('/api/notes');
  var allNotes = await allRes.json();
  var outsideNotes = allNotes.filter(function(n) { return !n.tags || n.tags.indexOf(name) === -1; });
  outsideNotes.sort(function(a,b) { return new Date(b.updatedAt) - new Date(a.updatedAt); });
  var noteList = '';
  if (outsideNotes.length) {
    noteList = '<div class="modal-field"><label>选择笔记加入此笔记本</label><div class="modal-check-list">' +
      outsideNotes.slice(0, 20).map(function(n) {
        return '<label class="modal-check-item"><input type="checkbox" value="' + n.slug + '"> ' + n.title.replace(/</g,'&lt;') + '</label>';
      }).join('') +
      (outsideNotes.length > 20 ? '<div style="padding:6px 12px;font-size:.78rem;color:var(--muted)">还有 ' + (outsideNotes.length - 20) + ' 篇...</div>' : '') +
    '</div></div>';
  } else {
    noteList = '<div style="font-size:.82rem;color:var(--muted);margin-bottom:12px">所有笔记已在此笔记本中。</div>';
  }

  var html = '<div class="settings-overlay" onclick="closeNbMeta(event)"><div class="settings-dialog" onclick="event.stopPropagation()">' +
    '<div class="settings-header"><span class="settings-title">笔记本设置</span><button class="picker-close" onclick="closeNbMeta()">&times;</button></div>' +
    '<div class="settings-body">' +
      '<div class="modal-field"><label>名称</label><input type="text" id="nbm-name" value="' + name.replace(/"/g, '&quot;') + '"></div>' +
      noteList +
    '</div>' +
    '<div class="settings-footer" style="display:flex;gap:10px;justify-content:space-between">' +
      '<span style="font-size:.8rem;color:var(--muted)">改名会更新关联笔记的标签</span>' +
      '<button class="btn" onclick="saveNbMeta(\'' + name + '\')">保存</button>' +
    '</div>' +
  '</div></div>';
  var div = document.createElement('div'); div.id = 'nb-meta-modal'; div.innerHTML = html;
  document.body.appendChild(div);
}
function closeNbMeta(e) {
  if (e && e.target !== document.querySelector('#nb-meta-modal .settings-overlay')) return;
  var el = document.getElementById('nb-meta-modal'); if (el) el.remove();
}
async function saveNbMeta(oldName) {
  var newName = document.getElementById('nbm-name').value.trim();
  if (!newName) { alert('请输入名称'); return; }
  // Collect selected note slugs
  var slugs = [];
  document.querySelectorAll('#nb-meta-modal .modal-check-item input:checked').forEach(function(cb) { slugs.push(cb.value); });
  try {
    var res = await fetch('/api/notebooks/' + encodeURIComponent(oldName), {
      method: 'PUT', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ newName: newName, addNotes: slugs })
    });
    var data = await res.json();
    if (data.ok) window.location.href = '/notebook/' + encodeURIComponent(data.name);
    else alert(data.error);
  } catch(err) { alert('保存失败：' + err.message); }
}
</script>

<% if (notes.length === 0) { %>
<div class="empty"><p>这个笔记本还是空的。</p><p style="margin-top:8px">编辑笔记时添加标签 "<strong><%= notebook %></strong>" 即可将其归入此笔记本。</p></div>
<% } else { %>
<div class="note-list">
  <% notes.forEach(n => { %>
  <div class="note-card" data-slug="<%= n.slug %>">
    <a href="/note/<%= encodeURIComponent(n.slug) %>" class="note-card-link">
      <h3><%= n.title %> <span class="badge"><%= n.type %></span></h3>
      <div class="meta"><%= new Date(n.updatedAt).toLocaleDateString('zh-CN') %> &middot; /note/<%= n.slug %></div>
    </a>
    <div class="card-actions card-actions-inline">
      <a href="/edit/<%= encodeURIComponent(n.slug) %>" class="card-action-btn card-edit" title="编辑" onclick="event.stopPropagation()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      </a>
      <button class="card-action-btn card-del" title="删除" onclick="event.stopPropagation(); delNoteCard(this, '<%= n.slug %>')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
      </button>
    </div>
  </div>
  <% }) %>
</div>
<% } %>

<%- include('footer') %>
