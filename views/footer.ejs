<button id="scroll-top-btn" class="scroll-top" onclick="window.scrollTo({top:0,behavior:'smooth'})" title="返回顶部">↑</button>

</main>
</div><!-- .app-layout -->
<script src="/app.js"></script>
<script>
// 检测桌面模式
if (window.electronAPI && window.electronAPI.isElectron) {
  const badge = document.getElementById('sidebar-mode-badge');
  if (badge) {
    badge.textContent = '🖥️ 桌面版';
    badge.style.background = 'var(--accent)';
    badge.style.color = '#fff';
  }
}

// 返回顶部按钮
(function() {
  var btn = document.getElementById('scroll-top-btn');
  if (!btn) return;
  window.addEventListener('scroll', function() {
    btn.style.display = window.scrollY > 300 ? 'flex' : 'none';
  });
  btn.style.display = 'none';
})();
</script>

<script>
document.addEventListener("keydown",function(e){var t=e.target.tagName;if(t==="INPUT"||t==="TEXTAREA"||t==="SELECT")return;switch(e.key){case"k":case"K":if(e.ctrlKey||e.metaKey){e.preventDefault();var s=document.getElementById("sidebar-search-input");if(s){s.focus();s.select()}}break;case"n":case"N":if(e.ctrlKey||e.metaKey){e.preventDefault();var b=document.querySelector('a[href="/new"]');if(b)b.click();else window.location.href="/new"}break;}});
</script>

<script>
function toggleNotebooks(){var list=document.getElementById("sidebar-notebook-list");var btn=document.getElementById("nb-collapse-btn");if(!list||!btn)return;if(list.style.display==="none"){list.style.display="";btn.textContent="▲";btn.title="收起笔记本列表"}else{list.style.display="none";btn.textContent="▼";btn.title="展开笔记本列表"}}
</script>

<script>
if("serviceWorker"in navigator){navigator.serviceWorker.register("/sw.js")}
</script>

<script>
function toggleMobileMenu(){var s=document.querySelector(".sidebar");var o=document.getElementById("sidebar-overlay");s.classList.toggle("open");o.classList.toggle("active")}
function closeMobileMenu(){document.querySelector(".sidebar").classList.remove("open");document.getElementById("sidebar-overlay").classList.remove("active")}
</script>
</body>
</html>
