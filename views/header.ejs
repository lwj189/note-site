<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof heading !== 'undefined' ? heading + ' - ' : '' %><%= site %></title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/hljs-theme.css">
  <link rel="icon" type="image/png" href="/icon-192.png">
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#4361ee">
<meta name="apple-mobile-web-app-capable" content="yes">
</head>
<body>
<button id="menu-btn" onclick="toggleMobileMenu()" style="display:none;position:fixed;top:12px;left:12px;z-index:500;width:40px;height:40px;border:none;border-radius:8px;background:var(--accent);color:#fff;font-size:1.2rem;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.15)">☰</button>
<div class="sidebar-overlay" id="sidebar-overlay" onclick="closeMobileMenu()"></div>
<div class="app-layout">
<aside class="sidebar">
  <a href="/" class="sidebar-logo">
    <span class="logo-icon"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8M8 17h5"/></svg></span>
    <span class="logo-text">MyNote</span>
  </a>

  <div class="sidebar-search">
    <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input type="text" id="sidebar-search-input" placeholder="搜索笔记..." autocomplete="off">
    <div id="sidebar-search-results" class="sidebar-search-results" style="display:none"></div>
  </div>

  <nav class="sidebar-nav">
    <a href="/" class="nav-card nav-home<%= typeof current !== 'undefined' && current === 'home' ? ' active' : '' %>">
      <span class="nav-card-icon">🏠</span>
      <span class="nav-card-label">首页</span>
      <span class="nav-card-arrow">→</span>
    </a>
    <a href="/notebooks" class="nav-card nav-notebook">
      <span class="nav-card-icon">📁</span>
      <span class="nav-card-label">笔记本</span>
      <span class="nav-card-arrow">→</span>
    </a>
    <div style="display:flex;align-items:center;padding:2px 12px">
      <button id="nb-collapse-btn" onclick="toggleNotebooks()" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:.7rem;padding:2px 6px" title="收起笔记本列表">▲</button>
      <span style="font-size:.65rem;color:var(--muted);margin-left:4px">笔记本</span>
    </div>
    <div id="sidebar-notebook-list" class="sidebar-notebook-list-inside">
      <div class="sidebar-recent-loading">加载中...</div>
    </div>
    <a href="/list" class="nav-card nav-list<%= typeof current !== 'undefined' && current === 'list' ? ' active' : '' %>">
      <span class="nav-card-icon">📋</span>
      <span class="nav-card-label">全部笔记</span>
      <span class="nav-card-arrow">→</span>
    </a>
    <a href="/gallery" class="nav-card nav-gallery<%= typeof current !== 'undefined' && current === 'gallery' ? ' active' : '' %>">
      <span class="nav-card-icon">🖼️</span>
      <span class="nav-card-label">图库</span>
      <span class="nav-card-arrow">→</span>
    </a>
    <a href="/trash" class="nav-card nav-trash<%= typeof current !== 'undefined' && current === 'trash' ? ' active' : '' %>">
      <span class="nav-card-icon">🗑️</span>
      <span class="nav-card-label">回收站</span>
      <span class="nav-card-arrow">→</span>
    </a>
  </nav>

  <div class="sidebar-recent">
    <div class="sidebar-recent-title">最近笔记</div>
    <div id="sidebar-recent-list" class="sidebar-recent-list">
      <div class="sidebar-recent-loading">加载中...</div>
    </div>
  </div>

  <div class="sidebar-bottom">
    <div class="sidebar-git-status" id="sidebar-git-status" title="Git 同步状态">⋯</div>
    <div class="sidebar-mode-badge" id="sidebar-mode-badge">🌐 网页版</div>
    <% if (typeof publicUrl !== 'undefined' && publicUrl) { %>
    <div class="sidebar-public-url" title="公网访问链接" onclick="navigator.clipboard.writeText('<%= publicUrl %>');this.classList.add('copied');setTimeout(()=>this.classList.remove('copied'),1500)">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
      <span class="public-url-text">公网链接</span>
      <span class="copied-hint">已复制</span>
    </div>
    <% } %>
    <button class="sidebar-settings-btn" onclick="openSettings()" title="设置">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
    </button>
    <div class="sidebar-footer">&copy; 2026 MyNote</div>
  </div>
</aside>
<main>
