<%- include('header', { heading: note.title, current: typeof current !== 'undefined' ? current : '' }) %>

<article>
  <div class="note-header">
    <div class="note-header-left">
      <h1><%= note.title %></h1>
      <div class="date">更新于 <%= new Date(note.updatedAt).toLocaleString('zh-CN') %> &middot; 类型：<%= note.type %></div>
      <% if (note.tags && note.tags.length) { %>
      <div class="tag-list" style="margin-top:8px">
        <% note.tags.forEach(t => { %>
        <a href="/notebook/<%= encodeURIComponent(t) %>" class="tag-badge tag-badge-lg"><%= t %></a>
        <% }) %>
      </div>
      <% } %>
    </div>
    <div class="note-header-actions">
      <button class="card-action-btn card-pin-btn<%= note.pinned ? ' pinned' : '' %>" id="note-pin-btn" title="<%= note.pinned ? '取消置顶' : '置顶到顶部' %>" onclick="togglePin('<%= note.slug %>')">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <span><%= note.pinned ? '已置顶' : '置顶' %></span>
      </button>
      <button class="card-action-btn" id="note-toc-btn" title="目录大纲" onclick="toggleToc()">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
        <span>目录</span>
      </button>
      <a href="/edit/<%= encodeURIComponent(note.slug) %>" class="card-action-btn card-edit" title="编辑内容">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        <span>编辑</span>
      </a>
      <button class="card-action-btn" title="导出" onclick="exportNote()" style="opacity:1;width:auto;padding:7px 12px;gap:6px;font-size:.85rem;font-family:inherit;font-weight:500">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        <span>导出</span>
      </button>
      <button class="card-action-btn" title="设置" onclick="editNoteMeta('<%= note.slug %>', '<%= note.title.replace(/'/g, "\\'") %>', '<%= note.type %>', '<%= note.tags ? note.tags.join(', ') : '' %>')" style="opacity:1;width:auto;padding:7px 12px;gap:6px;font-size:.85rem;font-family:inherit;font-weight:500">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        <span>设置</span>
      </button>
      <button class="card-action-btn card-del" title="删除" onclick="delNote('<%= note.slug %>')">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
        <span>删除</span>
      </button>
    </div>
  </div>
  <div class="note-body"><%- html %></div>
<input type="hidden" id="note-original-content" value="<%= note.content.replace(/"/g, '&quot;') %>">
</article>

<% if (backlinks && backlinks.length) { %>
<div class="note-backlinks">
  <h2>反向链接（<%= backlinks.length %>）</h2>
  <ul>
    <% backlinks.forEach(b => { %>
    <li><a href="/note/<%= encodeURIComponent(b.slug) %>"><%= b.title %></a></li>
    <% }) %>
  </ul>
</div>
<% } %>

<style>.code-copy-btn{position:absolute;top:8px;right:8px;padding:4px 10px;font-size:.75rem;background:rgba(255,255,255,.1);color:#94a3b8;border:1px solid rgba(255,255,255,.15);border-radius:4px;cursor:pointer;opacity:0;transition:all .15s;font-family:inherit;z-index:2}pre:hover .code-copy-btn{opacity:1}.code-copy-btn:hover{background:rgba(255,255,255,.2);color:#fff}.code-copy-btn.copied{background:#16a34a;color:#fff;border-color:#16a34a}</style><script>(function(){document.querySelectorAll(".note-body pre").forEach(function(p){var b=document.createElement("button");b.className="code-copy-btn";b.textContent="复制";b.onclick=function(){var c=p.querySelector("code");var t=c?c.textContent:p.textContent;if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(t).then(function(){b.textContent="已复制";b.classList.add("copied");setTimeout(function(){b.textContent="复制";b.classList.remove("copied")},2000)})}else{var a=document.createElement("textarea");a.value=t;a.style.position="fixed";a.style.left="-9999px";document.body.appendChild(a);a.select();document.execCommand("copy");document.body.removeChild(a);b.textContent="已复制";setTimeout(function(){b.textContent="复制"},2000)}};p.style.position="relative";p.appendChild(b)})})();</script>

<a href="/" class="back">&larr; 返回首页</a>

<!-- 目录大纲面板 -->
<div id="note-toc-panel" class="note-toc-panel" style="display:none">
  <div class="note-toc-title">目录大纲</div>
  <input id="note-toc-filter" class="note-toc-filter" type="search" placeholder="过滤标题…" style="display:none">
  <nav id="note-toc-list" class="note-toc-list"></nav>
</div>

<!-- 悬浮目录按钮：滚动一段后常驻右下角，长笔记里不用再回顶部 -->
<button id="note-toc-fab" class="note-toc-fab" title="目录大纲（随时可点）" style="display:none" onclick="toggleToc(true)">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
</button>

<!-- Image lightbox with zoom -->
<div id="img-lightbox" class="img-lightbox" onclick="closeImgLightbox(event)">
  <span class="img-lightbox-close" onclick="closeImgLightbox()">&times;</span>
  <div class="img-lightbox-inner" id="img-lightbox-inner">
    <img id="img-lightbox-img" src="" alt="">
    <div class="img-lightbox-zoom-info" id="img-zoom-info">100%</div>
  </div>
  <div class="img-lightbox-toolbar">
    <button class="img-zoom-btn" onclick="zoomImg(-0.25)" title="缩小">−</button>
    <span class="img-zoom-level" id="img-zoom-level">100%</span>
    <button class="img-zoom-btn" onclick="zoomImg(0.25)" title="放大">+</button>
    <button class="img-zoom-btn" onclick="resetZoom()" title="重置">⟲</button>
  </div>
</div>

<script>
// 待办清单勾选：点击 checkbox 切换并保存到笔记内容
(function() {
  var body = document.querySelector('.note-body');
  var contentInput = document.getElementById('note-original-content');
  if (!body || !contentInput) return;
  var boxes = body.querySelectorAll('input[type="checkbox"]');
  if (!boxes.length) return;

  var SLUG = <%- JSON.stringify(note.slug) %>;
  var TITLE = <%- JSON.stringify(note.title) %>;
  var TYPE = <%- JSON.stringify(note.type) %>;
  var TAGS = <%- JSON.stringify(note.tags ? note.tags.join(',') : '') %>;

  function taskLines(content) {
    var lines = content.split('\n');
    var idx = [];
    lines.forEach(function(line, i) { if (/^\s*[-*+]\s+\[[ xX]\]/.test(line)) idx.push(i); });
    return { lines: lines, idx: idx };
  }

  function persist(lines, box) {
    var content = lines.join('\n');
    contentInput.value = content;
    fetch('/api/notes', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ title: TITLE, slug: SLUG, content: content, type: TYPE, tags: TAGS })
    }).then(function(r) { return r.json(); }).then(function(data) {
      if (!data.ok) { box.checked = !box.checked; alert('保存失败：' + data.error); }
    }).catch(function(err) { box.checked = !box.checked; alert('保存失败：' + err.message); });
  }

  boxes.forEach(function(box, i) {
    box.disabled = false;
    box.addEventListener('change', function() {
      var src = taskLines(contentInput.value);
      if (i >= src.idx.length) { box.checked = !box.checked; return; }
      var line = src.lines[src.idx[i]];
      src.lines[src.idx[i]] = line.replace(/\[[ xX]\]/, box.checked ? '[x]' : '[ ]');
      persist(src.lines, box);
    });
  });
})();
</script>

<script>
// 目录大纲：自动生成标题索引，点击跳转，滚动高亮当前位置
(function() {
  var body = document.querySelector('.note-body');
  var btn = document.getElementById('note-toc-btn');
  var fab = document.getElementById('note-toc-fab');
  if (!body || !btn) return;
  var heads = body.querySelectorAll('h1, h2, h3, h4');
  if (!heads.length) { btn.style.display = 'none'; if (fab) fab.style.display = 'none'; return; }
  var items = [];
  heads.forEach(function(h, i) {
    if (!h.id) h.id = 'note-toc-h' + i;
    items.push({ el: h, level: +h.tagName[1], text: h.textContent.trim() });
  });
  if (items.length < 2) { btn.style.display = 'none'; if (fab) fab.style.display = 'none'; return; }
  var list = document.getElementById('note-toc-list');
  if (!list) return;
  items.forEach(function(it) {
    var a = document.createElement('a');
    a.href = '#' + it.el.id;
    a.className = 'note-toc-item note-toc-lv' + it.level;
    a.textContent = it.text;
    a.addEventListener('click', function(e) {
      e.preventDefault();
      it.el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      closeToc(); // 跳转后自动收起目录
    });
    it.a = a;
    list.appendChild(a);
  });
  var current = items[0];
  function markCurrent() {
    var anchor = window.scrollY + 80;
    var cur = items[0];
    items.forEach(function(it) {
      var top = it.el.getBoundingClientRect().top + window.scrollY;
      if (top <= anchor) cur = it;
    });
    current = cur;
    items.forEach(function(it) {
      it.el.classList.toggle('toc-active', it === cur);
      if (it.a) it.a.classList.toggle('toc-item-active', it === cur);
    });
  }
  window.addEventListener('scroll', markCurrent, { passive: true });
  markCurrent();

  // 打开面板时，把"当前章节"滚到面板中间：长目录里一眼看到自己在哪
  window.__noteTocScrollActive = function() {
    var panel = document.getElementById('note-toc-panel');
    if (!panel || !current || !current.a) return;
    panel.scrollTop = Math.max(0, current.a.offsetTop - panel.clientHeight / 2 + current.a.offsetHeight / 2);
  };

  // 标题过滤：长目录（≥20 条）里直接搜章节名，不用一页页翻
  var filter = document.getElementById('note-toc-filter');
  if (filter) {
    if (items.length >= 20) filter.style.display = 'block';
    filter.addEventListener('input', function() {
      var q = filter.value.trim().toLowerCase();
      items.forEach(function(it) {
        if (!it.a) return;
        it.a.style.display = (!q || it.a.textContent.toLowerCase().indexOf(q) >= 0) ? '' : 'none';
      });
      var panel = document.getElementById('note-toc-panel');
      if (panel && !q) panel.scrollTop = 0;
    });
  }

  // 悬浮目录按钮：滚过一屏就出现，长笔记里不用再回顶部
  if (fab) {
    var syncFab = function() { fab.style.display = window.scrollY > 300 ? 'flex' : 'none'; };
    window.addEventListener('scroll', syncFab, { passive: true });
    syncFab();
  }
})();

function closeToc() {
  var panel = document.getElementById('note-toc-panel');
  var btn = document.getElementById('note-toc-btn');
  var fab = document.getElementById('note-toc-fab');
  if (panel) panel.style.display = 'none';
  if (btn) btn.classList.remove('active');
  if (fab) fab.classList.remove('active');
}

function toggleToc(fromFab) {
  var panel = document.getElementById('note-toc-panel');
  var btn = document.getElementById('note-toc-btn');
  var fab = document.getElementById('note-toc-fab');
  if (!panel) return;
  if (panel.style.display === 'block') { closeToc(); return; }
  // 从右下角悬浮按钮打开时，面板贴着按钮弹出（见 .note-toc-panel.from-fab）
  panel.classList.toggle('from-fab', !!fromFab);
  panel.style.display = 'block';
  if (btn) btn.classList.toggle('active', !fromFab);
  if (fab) fab.classList.toggle('active', !!fromFab);
  if (window.__noteTocScrollActive) window.__noteTocScrollActive();
}

// 点击目录面板和按钮之外的任何地方 → 收起目录（捕获阶段，避免被内部 stopPropagation 拦掉）
document.addEventListener('click', function(e) {
  var panel = document.getElementById('note-toc-panel');
  if (!panel || panel.style.display !== 'block') return;
  if (panel.contains(e.target)) return;
  var btn = document.getElementById('note-toc-btn');
  var fab = document.getElementById('note-toc-fab');
  if ((btn && btn.contains(e.target)) || (fab && fab.contains(e.target))) return;
  closeToc();
}, true);

// Esc 也收起目录
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape' || e.keyCode === 27) closeToc();
});
</script>

<script>
// Image lightbox with zoom & pan
var imgZoom = 1;
var imgPanX = 0, imgPanY = 0;
var isPanning = false;
var panStartX, panStartY;

(function() {
  document.querySelectorAll('.note-body img').forEach(function(img) {
    img.style.cursor = 'zoom-in';
    img.addEventListener('click', function() {
      openImgLightbox(this.src);
    });
  });
})();

function openImgLightbox(src) {
  imgZoom = 1;
  imgPanX = 0;
  imgPanY = 0;
  applyZoom();
  document.getElementById('img-lightbox-img').src = src;
  document.getElementById('img-lightbox').classList.add('active');
}

function closeImgLightbox(e) {
  if (e && e.target !== document.getElementById('img-lightbox')) return;
  document.getElementById('img-lightbox').classList.remove('active');
}

// Mouse wheel zoom
document.getElementById('img-lightbox').addEventListener('wheel', function(e) {
  if (!document.getElementById('img-lightbox').classList.contains('active')) return;
  e.preventDefault();
  var delta = e.deltaY > 0 ? -0.1 : 0.1;
  zoomImg(delta);
}, { passive: false });

function zoomImg(delta) {
  imgZoom = Math.max(0.5, Math.min(5, imgZoom + delta));
  applyZoom();
}

function applyZoom() {
  var img = document.getElementById('img-lightbox-img');
  var info = document.getElementById('img-zoom-info');
  var level = document.getElementById('img-zoom-level');
  img.style.transform = 'scale(' + imgZoom + ') translate(' + imgPanX + 'px, ' + imgPanY + 'px)';
  var pct = Math.round(imgZoom * 100) + '%';
  info.textContent = pct;
  level.textContent = pct;
}

function resetZoom() {
  imgZoom = 1;
  imgPanX = 0;
  imgPanY = 0;
  applyZoom();
}

// Pan: drag image when zoomed
(function() {
  var inner = document.getElementById('img-lightbox-inner');
  inner.addEventListener('mousedown', function(e) {
    if (imgZoom <= 1) return;
    isPanning = true;
    panStartX = e.clientX - imgPanX;
    panStartY = e.clientY - imgPanY;
    inner.style.cursor = 'grabbing';
  });
  document.addEventListener('mousemove', function(e) {
    if (!isPanning) return;
    imgPanX = e.clientX - panStartX;
    imgPanY = e.clientY - panStartY;
    applyZoom();
  });
  document.addEventListener('mouseup', function() {
    isPanning = false;
    if (inner) inner.style.cursor = imgZoom > 1 ? 'grab' : '';
  });
  // Double-click to reset
  inner.addEventListener('dblclick', resetZoom);
})();
</script>

<script>
function exportNote() {
  var title = document.querySelector('.note-header h1').textContent.trim();
  var content = document.getElementById('note-original-content').value;
  if (!content) content = document.querySelector('.note-body').textContent;
  var blob = new Blob([content], {type: 'text/markdown;charset=utf-8'});
  var url = URL.createObjectURL(blob);
  var a = document.createElement('a');
  a.href = url;
  a.download = title.replace(/[\\/:*?"<>|]/g, '_') + '.md';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

async function togglePin(slug) {
  try {
    const res = await fetch('/api/notes/' + encodeURIComponent(slug) + '/pin', { method: 'POST' });
    const data = await res.json();
    if (!data.ok) { alert('操作失败：' + data.error); return; }
    const btn = document.getElementById('note-pin-btn');
    btn.classList.toggle('pinned', data.pinned);
    btn.title = data.pinned ? '取消置顶' : '置顶到顶部';
    btn.querySelector('span').textContent = data.pinned ? '已置顶' : '置顶';
  } catch (err) { alert('操作失败：' + err.message); }
}

async function delNote(slug) {
  if (!confirm('确定删除笔记 "' + slug + '" 吗？将移到回收站，可还原。')) return;
  try {
    const res = await fetch('/api/notes/' + encodeURIComponent(slug), { method: 'DELETE' });
    const data = await res.json();
    if (data.ok) {
      window.location.href = '/';
    } else {
      alert('删除失败：' + data.error);
    }
  } catch (err) {
    alert('删除失败：' + err.message);
  }
}

function editNoteMeta(slug, title, type, tags) {
  var html = '<div class="settings-overlay" onclick="closeNoteMeta(event)"><div class="settings-dialog" onclick="event.stopPropagation()">' +
    '<div class="settings-header"><span class="settings-title">编辑信息</span><button class="picker-close" onclick="closeNoteMeta()">&times;</button></div>' +
    '<div class="settings-body">' +
      '<div class="modal-field"><label>标题</label><input type="text" id="nm-title" value="' + title.replace(/"/g, '&quot;') + '"></div>' +
      '<div class="modal-field"><label>类型</label><select id="nm-type"><option value="md"' + (type==='md'?' selected':'') + '>Markdown</option><option value="txt"' + (type==='txt'?' selected':'') + '>纯文本</option><option value="cpp"' + (type==='cpp'?' selected':'') + '>C++</option><option value="python"' + (type==='python'?' selected':'') + '>Python</option><option value="javascript"' + (type==='javascript'?' selected':'') + '>JavaScript</option></select></div>' +
      '<div class="modal-field"><label>笔记本 / 标签（点击选择，可多选）</label><div id="nm-nb-picker" class="nb-picker"></div><input type="hidden" id="nm-tags" value="' + tags.replace(/"/g, '&quot;') + '"></div>' +
    '</div>' +
    '<div class="settings-footer"><button class="btn" onclick="saveNoteMeta(\'' + slug + '\')">保存</button></div>' +
  '</div></div>';
  var div = document.createElement('div'); div.id = 'note-meta-modal'; div.innerHTML = html;
  document.body.appendChild(div);
  if (typeof createNotebookPicker === 'function') {
    var nbRoot = document.getElementById('nm-nb-picker');
    var nbHidden = document.getElementById('nm-tags');
    if (nbRoot && nbHidden) {
      createNotebookPicker(nbRoot, {
        all: (typeof NOTEBOOKS_ALL !== 'undefined' ? NOTEBOOKS_ALL : []),
        selected: (nbHidden.value || '').split(',').map(function (s) { return s.trim(); }).filter(Boolean),
        hiddenInput: nbHidden
      });
    }
  }
}
function closeNoteMeta(e) {
  if (e && e.target !== document.querySelector('#note-meta-modal .settings-overlay')) return;
  var el = document.getElementById('note-meta-modal'); if (el) el.remove();
}
async function saveNoteMeta(slug) {
  var title = document.getElementById('nm-title').value.trim();
  var type = document.getElementById('nm-type').value;
  var tags = document.getElementById('nm-tags').value.trim();
  if (!title) { alert('请输入标题'); return; }
  try {
    var res = await fetch('/api/notes', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ title: title, slug: slug, content: document.getElementById('note-original-content').value, type: type, tags: tags })
    });
    var data = (typeof readJSON === 'function') ? await readJSON(res) : await res.json();
    if (data.ok) window.location.reload();
    else alert(data.error);
  } catch(err) { alert('保存失败：' + err.message); }
}
</script>

<script src="/notebook-picker.js"></script>
<script>
// 笔记本清单（供"设置"弹窗里的选择器使用）
var NOTEBOOKS_ALL = <%- JSON.stringify(typeof notebooks !== 'undefined' ? notebooks : []) %>;
</script>

<%- include('footer') %>
