<%- include('header', { heading: typeof note !== 'undefined' ? '编辑: ' + note.title : '新建笔记', current: typeof current !== 'undefined' ? current : 'editor' }) %>

<div class="editor-page">
  <div class="editor-toolbar">
    <!-- Formatting -->
    <button type="button" class="toolbar-btn" onclick="mdFormat('bold')" title="加粗 Ctrl+B"><b>B</b></button>
    <button type="button" class="toolbar-btn" onclick="mdFormat('italic')" title="斜体 Ctrl+I"><i>I</i></button>
    <button type="button" class="toolbar-btn" onclick="mdFormat('strike')" title="删除线"><s>S</s></button>
    <button type="button" class="toolbar-btn" onclick="mdFormat('code')" title="行内代码">⌨</button>
    <span class="toolbar-sep"></span>
    <button type="button" class="toolbar-btn" onclick="mdFormat('h1')" title="标题1">H1</button>
    <button type="button" class="toolbar-btn" onclick="mdFormat('h2')" title="标题2">H2</button>
    <button type="button" class="toolbar-btn" onclick="mdFormat('h3')" title="标题3">H3</button>
    <span class="toolbar-sep"></span>
    <button type="button" class="toolbar-btn" onclick="mdFormat('ul')" title="无序列表">‣</button>
    <button type="button" class="toolbar-btn" onclick="mdFormat('ol')" title="有序列表">#.</button>
    <button type="button" class="toolbar-btn" onclick="mdFormat('quote')" title="引用">“</button>
    <button type="button" class="toolbar-btn" onclick="mdFormat('codeblock')" title="代码块">↻</button>
    <span class="toolbar-sep"></span>
    <button type="button" class="toolbar-btn" onclick="mdFormat('link')" title="插入链接">⛓</button>
    <button type="button" class="toolbar-btn" onclick="mdFormat('hr')" title="分隔线">━</button>
    <span class="toolbar-sep"></span>
    <button type="button" class="toolbar-btn" onclick="openImagePicker()" title="插入图片">🖼</button>
    <button type="button" class="toolbar-btn" onclick="openTemplatePicker()" title="笔记模板">📋</button>
    <label class="toolbar-btn" title="插入文件">📄
      <input type="file" id="tb-file-input" accept=".txt,.cpp,.md,.h,.hpp,.c,.py,.js,.ts,.java,.cs,.go,.rs,.rb,.php,.html,.css,.json,.xml,.yaml,.yml,.sql,.sh,.bat,.ps1,.docx" hidden>
    </label>
    <span class="toolbar-sep"></span>
    <button type="button" class="toolbar-btn" id="tb-preview-btn" onclick="togglePreview()">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
      预览
      </button>
    <div id="toolbar-msg" class="toolbar-msg"></div><button type="button" class="toolbar-btn" onclick="toggleFullscreen()" title="全屏写作" style="margin-left:auto">⛶</button><span id="word-count" style="font-size:.78rem;color:var(--muted);margin-left:12px"></span><span id="save-status" style="font-size:.78rem;color:var(--muted);margin-left:auto"></span>
  </div>

  <form id="editor-form">
    <% const isQuick = typeof quick !== 'undefined' && quick; %>
    <div class="editor-meta" id="editor-meta" style="<%= isQuick ? 'display:none' : '' %>">
      <div class="editor-field">
        <label>标题</label>
        <input type="text" name="title" id="e-title" value="<%= typeof note !== 'undefined' ? note.title : (typeof prefill !== 'undefined' ? prefill.title : '') %>" placeholder="笔记标题"<%= isQuick ? '' : ' required' %>>
      </div>
      <div class="editor-field">
        <label>网址路径</label>
        <input type="text" name="slug" id="e-slug" value="<%= typeof note !== 'undefined' ? note.slug : (typeof prefill !== 'undefined' ? prefill.slug : '') %>" placeholder="note-url-path"<%= isQuick ? '' : ' required' %>>
      </div>
      <div class="editor-field">
        <label>类型</label>
        <select name="type" id="e-type">
          <% const selType = typeof note !== 'undefined' ? note.type : (typeof prefill !== 'undefined' && prefill.type ? prefill.type : 'md'); %>
          <option value="md" <%= selType === 'md' ? 'selected' : '' %>>Markdown (.md)</option>
          <option value="txt" <%= selType === 'txt' ? 'selected' : '' %>>纯文本 (.txt)</option>
          <option value="cpp" <%= selType === 'cpp' ? 'selected' : '' %>>C++ (.cpp)</option>
          <option value="c" <%= selType === 'c' ? 'selected' : '' %>>C (.c)</option>
          <option value="python" <%= selType === 'python' ? 'selected' : '' %>>Python (.py)</option>
          <option value="javascript" <%= selType === 'javascript' ? 'selected' : '' %>>JavaScript (.js)</option>
          <option value="typescript" <%= selType === 'typescript' ? 'selected' : '' %>>TypeScript (.ts)</option>
          <option value="java" <%= selType === 'java' ? 'selected' : '' %>>Java (.java)</option>
          <option value="go" <%= selType === 'go' ? 'selected' : '' %>>Go (.go)</option>
          <option value="rust" <%= selType === 'rust' ? 'selected' : '' %>>Rust (.rs)</option>
          <option value="csharp" <%= selType === 'csharp' ? 'selected' : '' %>>C# (.cs)</option>
          <option value="sql" <%= selType === 'sql' ? 'selected' : '' %>>SQL (.sql)</option>
          <option value="bash" <%= selType === 'bash' ? 'selected' : '' %>>Bash (.sh)</option>
          <option value="json" <%= selType === 'json' ? 'selected' : '' %>>JSON (.json)</option>
          <option value="xml" <%= selType === 'xml' ? 'selected' : '' %>>HTML/XML</option>
          <option value="css" <%= selType === 'css' ? 'selected' : '' %>>CSS</option>
        </select>
      </div>
      <div class="editor-field">
        <label>标签（逗号分隔）</label>
        <input type="text" name="tags" id="e-tags" value="<%= typeof note !== 'undefined' && note.tags ? note.tags.join(', ') : (typeof prefill !== 'undefined' ? prefill.tags : '') %>" placeholder="如: 工作, 待整理, 灵感">
      </div>
    </div>

    <div class="editor-area" id="editor-area">
      <textarea name="content" id="e-content" placeholder="在此撰写内容...&#10;&#10;支持 Markdown 语法" required><%= typeof note !== 'undefined' ? note.content : '' %></textarea>
      <div id="e-preview" class="editor-preview note-body" style="display:none"></div>
    </div>

    <div class="editor-actions">
      <button type="submit" class="btn"><%= typeof note !== 'undefined' ? '保存笔记' : (isQuick ? '保存（自动生成标题）' : '保存笔记') %></button>
      <% if (typeof note !== 'undefined') { %>
      <a href="/note/<%= encodeURIComponent(note.slug) %>" class="btn btn-outline" target="_blank">查看笔记</a>
      <% } %>
      <a href="/" class="btn btn-outline">返回首页</a>
      <% if (isQuick) { %>
      <button type="button" class="btn btn-outline" onclick="toggleMeta()" style="margin-left:auto">设置标题/标签</button>
      <% } %>
    </div>
    <div id="editor-result" class="result"></div>
  </form>
</div>

<!-- Template Picker Modal -->
<div id="template-picker-overlay" class="picker-overlay" onclick="closeTemplatePicker(event)">
  <div class="picker-dialog" onclick="event.stopPropagation()">
    <div class="picker-header">
      <span class="picker-title">📋 笔记模板</span>
      <button type="button" class="picker-close" onclick="closeTemplatePicker()">&times;</button>
    </div>
    <div class="template-grid" id="template-grid">
      <div class="template-card" onclick="applyTemplate('meeting')">
        <div class="template-icon">👥</div>
        <div class="template-name">会议记录</div>
        <div class="template-desc">会议议题、讨论和行动项</div>
      </div>
      <div class="template-card" onclick="applyTemplate('study')">
        <div class="template-icon">📚</div>
        <div class="template-name">学习笔记</div>
        <div class="template-desc">知识点和心得体会</div>
      </div>
      <div class="template-card" onclick="applyTemplate('todo')">
        <div class="template-icon">✅</div>
        <div class="template-name">待办清单</div>
        <div class="template-desc">任务列表和进度追踪</div>
      </div>
      <div class="template-card" onclick="applyTemplate('daily')">
        <div class="template-icon">📅</div>
        <div class="template-name">日报/周报</div>
        <div class="template-desc">工作内容和计划总结</div>
      </div>
      <div class="template-card" onclick="applyTemplate('problem')">
        <div class="template-icon">🔍</div>
        <div class="template-name">问题记录</div>
        <div class="template-desc">Bug/问题及解决方案</div>
      </div>
    </div>
  </div>
</div>

<script>
// ---- Markdown Formatting ----
function mdFormat(type) {
  var ta = document.getElementById('e-content');
  var start = ta.selectionStart;
  var end = ta.selectionEnd;
  var sel = ta.value.substring(start, end);
  var before = ta.value.substring(0, start);
  var after = ta.value.substring(end);
  var text = '';
  var cursor = start;
  switch (type) {
    case 'bold': text = '**' + (sel || 'bold') + '**'; cursor = sel ? start + text.length : start + 2; break;
    case 'italic': text = '*' + (sel || 'italic') + '*'; cursor = sel ? start + text.length : start + 1; break;
    case 'strike': text = '~~' + (sel || 'strike') + '~~'; cursor = sel ? start + text.length : start + 2; break;
    case 'code': text = '`' + (sel || 'code') + '`'; cursor = sel ? start + text.length : start + 1; break;
    case 'h1': text = '# ' + (sel || 'Heading 1'); cursor = start + text.length; break;
    case 'h2': text = '## ' + (sel || 'Heading 2'); cursor = start + text.length; break;
    case 'h3': text = '### ' + (sel || 'Heading 3'); cursor = start + text.length; break;
    case 'ul': text = '- ' + (sel || 'item'); cursor = start + text.length; break;
    case 'ol': text = '1. ' + (sel || 'item'); cursor = start + text.length; break;
    case 'quote': text = '> ' + (sel || 'quote'); cursor = start + text.length; break;
    case 'link': text = '[' + (sel || 'link text') + '](url)'; cursor = sel ? start + text.length - 2 : start + 1; break;
    case 'hr': text = '\n\n---\n\n'; cursor = start + 7; break;
    case 'codeblock': text = '```\n' + (sel || 'code') + '\n```'; cursor = start + text.length; break;
  }
  ta.value = before + text + after;
  ta.selectionStart = ta.selectionEnd = cursor;
  ta.focus();
}

// ---- Templates ----
const TEMPLATES = {
  meeting: '# 会议记录 - [会议名称]\n\n**时间**： [日期]\n**参与人员**： [姓名]\n\n## 议题\n1. [议题一]\n2. [议题二]\n\n## 讨论内容\n- [关键点]\n\n## 行动项\n- [ ] [行动项] - 负责人：[姓名]\n- [ ] [行动项] - 截止：[日期]',
  study: '# [学习主题]\n\n## 概述\n[内容总结]\n\n## 关键点\n- [点一]\n- [点二]\n\n## 代码示例\n```\n[示例代码]\n```\n\n## 总结\n- [心得体会]',
  todo: '# 待办清单\n\n## [分类一]\n- [ ] [任务]\n- [ ] [任务]\n\n## [分类二]\n- [x] [已完成]\n- [ ] [待办]\n\n---\n进度： [数字]%',
  daily: '# [日期] 日报\n\n## 今日完成\n- [工作内容]\n- [工作内容]\n\n## 遇到的问题\n- [问题及解决方案]\n\n## 明日计划\n- [计划内容]',
  problem: '# [问题标题]\n\n## 环境\n- 系统：[版本]\n\n## 问题描述\n[详细描述]\n\n## 排查过程\n1. [步骤一]\n2. [步骤二]\n\n## 解决方案\n```\n[解决方案代码/步骤]\n```\n\n## 预防措施\n- [措施]'
};

function openTemplatePicker() {
  document.getElementById('template-picker-overlay').classList.add('active');
}

function closeTemplatePicker(e) {
  if (e && e.target !== document.getElementById('template-picker-overlay')) return;
  document.getElementById('template-picker-overlay').classList.remove('active');
}

function applyTemplate(name) {
  var content = TEMPLATES[name];
  if (!content) return;
  var ta = document.getElementById('e-content');
  ta.value = content;
  ta.focus();
  closeTemplatePicker();
}
</script>

<div id="image-picker-overlay" class="picker-overlay" onclick="closeImagePicker(event)">
  <div class="picker-dialog" onclick="event.stopPropagation()">
    <div class="picker-header">
      <span class="picker-title">插入图片</span>
      <button type="button" class="picker-close" onclick="closeImagePicker()">&times;</button>
    </div>
    <div class="picker-tabs">
      <button class="picker-tab active" onclick="switchPickerTab('gallery', this)">图库图片</button>
      <button class="picker-tab" onclick="switchPickerTab('upload', this)">本地上传</button>
    </div>

    <!-- Gallery tab -->
    <div id="picker-gallery" class="picker-panel active">
      <div id="picker-gallery-grid" class="picker-gallery-grid">
        <div class="picker-loading">加载中...</div>
      </div>
      <div id="picker-gallery-bar" class="picker-gallery-bar" style="display:none">
        <div class="picker-bar-left">
          <button type="button" class="btn btn-sm btn-outline" onclick="toggleSelectAll()">全选</button>
          <span id="picker-select-count" class="picker-select-count">已选 0 张</span>
        </div>
        <button type="button" class="btn btn-sm" onclick="insertSelectedImages()">插入选中图片</button>
      </div>
    </div>

    <!-- Upload tab -->
    <div id="picker-upload" class="picker-panel">
      <div class="picker-upload-area">
        <p style="color:var(--muted);font-size:.88rem;margin-bottom:12px">选择本地图片上传到图库，同时插入到笔记中。支持多选。</p>
        <input type="file" id="picker-image-input" accept="image/*" multiple>
        <div id="picker-upload-progress" class="result" style="margin-top:12px"></div>
      </div>
    </div>
  </div>
</div>

<script>
const LANG_MAP = {
  '.cpp':'cpp','.c':'c','.h':'c','.hpp':'cpp',
  '.py':'python','.js':'javascript','.ts':'typescript',
  '.java':'java','.cs':'csharp','.go':'go','.rs':'rust',
  '.rb':'ruby','.php':'php','.html':'xml','.css':'css',
  '.json':'json','.xml':'xml','.yaml':'yaml','.yml':'yaml',
  '.sql':'sql','.sh':'bash','.bat':'dos','.ps1':'powershell',
  '.md':'md','.txt':'txt'
};

const textarea = document.getElementById('e-content');
let previewVisible = false;
let splitMode = false;
let livePreviewTimer = null;
let galleryImages = [];
let pickerOpen = false;
let selectedImages = new Set();
var imageSizes = {};

function insertAtCursor(text) {
  const start = textarea.selectionStart;
  const end = textarea.selectionEnd;
  const before = textarea.value.substring(0, start);
  const after = textarea.value.substring(end);
  textarea.value = before + text + after;
  textarea.selectionStart = textarea.selectionEnd = start + text.length;
  textarea.focus();
}

function showMsg(msg, isErr) {
  const el = document.getElementById('toolbar-msg');
  el.textContent = msg;
  el.className = 'toolbar-msg ' + (isErr ? 'error' : 'success');
  clearTimeout(el._t);
  el._t = setTimeout(() => el.className = 'toolbar-msg', 3000);
}

// ---- Image Picker ----
async function openImagePicker() {
  document.getElementById('image-picker-overlay').classList.add('active');
  pickerOpen = true;
  selectedImages.clear();
  document.querySelector('.picker-tab').classList.add('active');
  document.querySelectorAll('.picker-tab')[1].classList.remove('active');
  document.getElementById('picker-gallery').classList.add('active');
  document.getElementById('picker-upload').classList.remove('active');
  await loadGalleryImages();
}

function closeImagePicker(e) {
  if (e && e.target !== document.getElementById('image-picker-overlay')) return;
  document.getElementById('image-picker-overlay').classList.remove('active');
  pickerOpen = false;
}

function updateGalleryBar() {
  const bar = document.getElementById('picker-gallery-bar');
  const count = document.getElementById('picker-select-count');
  if (galleryImages.length === 0) {
    bar.style.display = 'none';
    return;
  }
  bar.style.display = 'flex';
  count.textContent = '已选 ' + selectedImages.size + ' 张';
}

async function loadGalleryImages() {
  const grid = document.getElementById('picker-gallery-grid');
  grid.innerHTML = '<div class="picker-loading">加载中...</div>';
  selectedImages.clear();
  try {
    const res = await fetch('/api/images');
    galleryImages = await res.json();
    if (galleryImages.length === 0) {
      grid.innerHTML = '<div class="picker-empty">图库中还没有图片。<br>切换到"本地上传"上传第一张图片。</div>';
      updateGalleryBar();
      return;
    }
    grid.innerHTML = galleryImages.map((img, idx) =>
      '<div class="picker-thumb' + (selectedImages.has(idx) ? ' selected' : '') + '" data-idx="' + idx + '" title="' + img.filename + '">' +
        '<div class="picker-check">' +
          '<input type="checkbox" ' + (selectedImages.has(idx) ? 'checked' : '') + ' onclick="event.stopPropagation(); toggleImageSelect(' + idx + ', this.checked)">' +
        '</div>' +
        '<img src="' + img.url + '" alt="' + img.filename + '" loading="lazy">' +
        '<span class="picker-thumb-name">' + (img.filename.length > 16 ? img.filename.slice(0,13)+'...' : img.filename) + '</span>' +
      '</div>'
    ).join('');
    // Attach click handlers
    grid.querySelectorAll('.picker-thumb').forEach(el => {
      el.addEventListener('click', function(e) {
        if (e.target.tagName === 'INPUT') return;
        const idx = parseInt(this.dataset.idx);
        const checkbox = this.querySelector('input[type="checkbox"]');
        const newChecked = !checkbox.checked;
        checkbox.checked = newChecked;
        toggleImageSelect(idx, newChecked);
      });
    });
    updateGalleryBar();
  } catch (err) {
    grid.innerHTML = '<div class="picker-empty">加载失败，请重试。</div>';
    updateGalleryBar();
  }
}

function toggleImageSelect(idx, checked) {
  if (checked) selectedImages.add(idx);
  else selectedImages.delete(idx);
  const thumb = document.querySelector('.picker-thumb[data-idx="' + idx + '"]');
  if (thumb) thumb.classList.toggle('selected', checked);
  updateGalleryBar();
}

function toggleSelectAll() {
  if (selectedImages.size === galleryImages.length) {
    selectedImages.clear();
  } else {
    galleryImages.forEach((_, i) => selectedImages.add(i));
  }
  document.querySelectorAll('.picker-thumb').forEach(el => {
    const idx = parseInt(el.dataset.idx);
    const cb = el.querySelector('input[type="checkbox"]');
    const checked = selectedImages.has(idx);
    cb.checked = checked;
    el.classList.toggle('selected', checked);
  });
  updateGalleryBar();
}

function insertSelectedImages() {
  if (selectedImages.size === 0) return;
  const sorted = [...selectedImages].sort((a, b) => a - b);
  let text = '';
  sorted.forEach(idx => {
    const img = galleryImages[idx];
    text += '![' + img.filename + '](' + img.url + ')\n';
  });
  insertAtCursor(text);
  closeImagePicker();
  setTimeout(showPreviewAfterInsert, 150);
}

function switchPickerTab(name, btn) {
  document.querySelectorAll('.picker-tab').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.picker-panel').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('picker-' + name).classList.add('active');
  if (name === 'gallery' && galleryImages.length === 0) {
    loadGalleryImages();
  }
}

// Upload from picker (supports multi-select)
document.getElementById('picker-image-input').addEventListener('change', async function() {
  const files = this.files;
  if (files.length === 0) return;
  const r = document.getElementById('picker-upload-progress');
  r.className = 'result';
  r.textContent = '上传 ' + files.length + ' 张图片中...';
  try {
    let inserted = 0;
    for (const file of files) {
      const fd = new FormData();
      fd.append('image', file);
      fd.append('alt', file.name);
      const res = await fetch('/api/upload-image', { method: 'POST', body: fd });
      const data = await res.json();
      if (data.ok) {
        insertAtCursor(data.md + '\n');
        inserted++;
        setTimeout(showPreviewAfterInsert, 150);
      }
    }
    if (inserted > 0) {
      r.className = 'result success';
      r.textContent = '已上传并插入 ' + inserted + ' 张图片';
      this.value = '';
      closeImagePicker();
    } else {
      r.className = 'result error';
      r.textContent = '上传失败';
    }
  } catch (err) {
    r.className = 'result error';
    r.textContent = '上传失败：' + err.message;
  }
});

// ---- File Insert ----
document.getElementById('tb-file-input').addEventListener('change', function() {
  const file = this.files[0];
  if (!file) return;
  const ext = '.' + file.name.split('.').pop().toLowerCase();
  if (ext === '.docx') {
    insertDocxFile(file);
    this.value = '';
    return;
  }
  showMsg('读取文件中...');
  const reader = new FileReader();
  reader.onload = function() {
    const content = reader.result;
    const lang = LANG_MAP[ext] || '';
    let text;
    if (lang && lang !== 'md' && lang !== 'txt') {
      text = '```' + lang + '\n' + content + '\n```\n';
    } else if (lang === 'md') {
      text = content + '\n';
    } else {
      text = '```\n' + content + '\n```\n';
    }
    insertAtCursor(text);
    showMsg('文件内容已插入');
  };
  reader.onerror = function() {
    showMsg('读取文件失败', true);
  };
  reader.readAsText(file);
  this.value = '';
});

async function insertDocxFile(file) {
  showMsg('解析 .docx 文件中...');
  try {
    const fd = new FormData();
    fd.append('file', file);
    const res = await fetch('/api/parse-docx', { method: 'POST', body: fd });
    const data = await res.json();
    if (data.ok) {
      insertAtCursor(data.text + '\n');
      showMsg('.docx 内容已插入');
    } else {
      showMsg(data.error, true);
    }
  } catch (err) {
    showMsg('解析 .docx 失败：' + err.message, true);
  }
}

// ---- Preview ----
async function renderPreview() {
  const preview = document.getElementById('e-preview');
  const content = textarea.value;
  if (!content.trim()) {
    preview.innerHTML = '<div class="preview-empty">暂无内容</div>';
    return;
  }
  preview.innerHTML = '<div class="preview-loading">渲染中...</div>';
  try {
    const res = await fetch('/api/render', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ content, type: document.getElementById('e-type').value })
    });
    const data = await res.json();
    if (data.html) {
      preview.innerHTML = data.html;
      // Make images resizable with 8-directional handles
      preview.querySelectorAll('img').forEach(img => {
        makeImageResizable(img);
      });
    } else {
      preview.innerHTML = '<div class="preview-empty">渲染失败</div>';
    }
  } catch (err) {
    preview.innerHTML = '<div class="preview-empty">渲染失败：' + err.message + '</div>';
  }
}

async function togglePreview() {
  if (splitMode) {
    // Exit split mode → back to textarea only
    splitMode = false;
    previewVisible = false;
    const preview = document.getElementById('e-preview');
    const btn = document.getElementById('tb-preview-btn');
    btn.classList.remove('active');
    btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg> 预览';
    textarea.style.display = '';
    preview.style.display = 'none';
    document.getElementById('editor-area').classList.remove('split');
    return;
  }

  if (!previewVisible) {
    // Enter preview mode
    previewVisible = true;
    const preview = document.getElementById('e-preview');
    const btn = document.getElementById('tb-preview-btn');
    btn.classList.add('active');
    btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg> 分屏模式';
    textarea.style.display = '';
    preview.style.display = '';
    document.getElementById('editor-area').classList.add('split');
    splitMode = true;
    await renderPreview();
  } else {
    // Toggle from preview-only to split mode is now handled above
    previewVisible = false;
    splitMode = false;
    const preview = document.getElementById('e-preview');
    const btn = document.getElementById('tb-preview-btn');
    btn.classList.remove('active');
    btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg> 预览';
    preview.style.display = 'none';
    document.getElementById('editor-area').classList.remove('split');
  }
}

// Live preview update in split mode
textarea.addEventListener('input', function() {
  if (!splitMode) return;
  if (livePreviewTimer) clearTimeout(livePreviewTimer);
  livePreviewTimer = setTimeout(renderPreview, 400);
});

// Auto-split on load if content has images
(function() {
  var content = textarea.value;
  if (/!\[.*?\]\(.*?\)|<img\s+[^>]*src=/i.test(content)) {
    // Automatically enter split mode
    setTimeout(function() {
      document.getElementById('tb-preview-btn').click();
    }, 100);
  }
})();

// ---- Image floating size toolbar ----
var activeImgToolbar = null;

function showImageToolbar(img) {
  if (activeImgToolbar) hideImageToolbar();
  var tb = document.createElement('div');
  tb.className = 'img-size-toolbar';
  var w = Math.round(img.offsetWidth);
  var h = Math.round(img.offsetHeight);
  var locked = true;
  var aspect = (img.naturalWidth / img.naturalHeight) || 1;

  tb.innerHTML =
    '<div class="img-size-row">' +
      '<label>宽</label><input type="number" class="img-size-input" id="img-size-w" value="' + w + '" min="20">' +
      '<label>高</label><input type="number" class="img-size-input" id="img-size-h" value="' + h + '" min="20">' +
      '<button class="img-size-lock" id="img-size-lock" title="锁定宽高比">🔗</button>' +
    '</div>' +
    '<div class="img-size-row">' +
      '<button class="btn btn-sm" id="img-size-apply">应用</button>' +
      '<button class="btn btn-sm btn-outline" id="img-size-close">关闭</button>' +
    '</div>';

  document.body.appendChild(tb);

  // Position near the image
  var rect = img.getBoundingClientRect();
  tb.style.left = Math.min(rect.left, window.innerWidth - 260) + 'px';
  tb.style.top = (rect.top - tb.offsetHeight - 8) + 'px';
  // If above viewport, show below
  if (parseInt(tb.style.top) < 10) {
    tb.style.top = (rect.bottom + 8) + 'px';
  }

  activeImgToolbar = { el: tb, img: img, aspect: aspect, locked: locked };

  var wInput = document.getElementById('img-size-w');
  var hInput = document.getElementById('img-size-h');
  var lockBtn = document.getElementById('img-size-lock');

  // Live update on input
  wInput.addEventListener('input', function() {
    if (activeImgToolbar && activeImgToolbar.locked) {
      hInput.value = Math.round(parseInt(this.value || 0) / aspect);
    }
  });
  hInput.addEventListener('input', function() {
    if (activeImgToolbar && activeImgToolbar.locked) {
      wInput.value = Math.round(parseInt(this.value || 0) * aspect);
    }
  });

  lockBtn.addEventListener('click', function() {
    if (activeImgToolbar) activeImgToolbar.locked = !activeImgToolbar.locked;
    this.textContent = activeImgToolbar && activeImgToolbar.locked ? '🔗' : '🔓';
  });

  document.getElementById('img-size-apply').addEventListener('click', function() {
    var newW = parseInt(wInput.value);
    var newH = parseInt(hInput.value);
    if (!newW || !newH || newW < 10 || newH < 10) return;
    img.style.width = newW + 'px';
    img.style.height = newH + 'px';
    syncImageSize(img, img.getAttribute('src'));
    hideImageToolbar();
  });

  document.getElementById('img-size-close').addEventListener('click', hideImageToolbar);

  // Click outside to close
  setTimeout(function() {
    document.addEventListener('click', tbOutsideClick, true);
  }, 10);
}

function tbOutsideClick(e) {
  if (activeImgToolbar && !activeImgToolbar.el.contains(e.target) && !e.target.closest('.img-size-toolbar')) {
    hideImageToolbar();
  }
}

function hideImageToolbar() {
  document.removeEventListener('click', tbOutsideClick, true);
  if (activeImgToolbar) {
    activeImgToolbar.el.remove();
    activeImgToolbar = null;
  }
}


(function(){var d=false,st=document.getElementById("save-status"),tm=null;textarea.addEventListener("input",function(){d=true;if(st)st.textContent="未保存";if(tm)clearTimeout(tm);tm=setTimeout(function(){if(!d)return;var f=document.getElementById("editor-form");if(f){var b=f.querySelector("button[type=submit]");if(b){d=false;if(st)st.textContent="自动保存中...";b.click();setTimeout(function(){if(st)st.textContent="已保存"},1000)}}},30000)})})();

// ---- 8-directional image resize ----
function makeImageResizable(img) {
  // Wrap in container
  const wrapper = document.createElement('span');
  wrapper.className = 'img-resizable';
  wrapper.style.cssText = 'display:inline-block;position:relative;max-width:100%;line-height:0';
  img.parentNode.insertBefore(wrapper, img);
  wrapper.appendChild(img);
  img.style.cssText = 'display:block;max-width:100%;height:auto';

  const url = img.getAttribute('src');
  let minW = 40, minH = 40;
  var origW = img.naturalWidth || 800;
  var origH = img.naturalHeight || 600;
  var aspect = origW / origH;

  // Click image to show size toolbar
  img.style.cursor = 'pointer';
  img.addEventListener('click', function(e) {
    if (e.target.closest('.resize-handle')) return;
    showImageToolbar(img);
  });

  // Create 8 handles
  var dirs = ['nw','n','ne','e','se','s','sw','w'];
  dirs.forEach(function(dir) {
    var h = document.createElement('div');
    h.className = 'resize-handle resize-handle-' + dir;
    wrapper.appendChild(h);
    h.addEventListener('mousedown', function(e) {
      e.preventDefault();
      e.stopPropagation();
      var startX = e.clientX, startY = e.clientY;
      var startW = img.offsetWidth, startH = img.offsetHeight;
      var shiftLock = false;

      function onMove(me) {
        var dx = me.clientX - startX;
        var dy = me.clientY - startY;
        var newW = startW, newH = startH;

        // Adjust based on handle direction
        if (dir.indexOf('e') !== -1) newW = startW + dx;
        if (dir.indexOf('w') !== -1) newW = startW - dx;
        if (dir.indexOf('s') !== -1) newH = startH + dy;
        if (dir.indexOf('n') !== -1) newH = startH - dy;

        // Shift key = maintain aspect ratio
        if (me.shiftKey || shiftLock) {
          if (dir === 'e' || dir === 'w') { newH = newW / aspect; }
          else if (dir === 'n' || dir === 's') { newW = newH * aspect; }
          else {
            // Corner: use larger delta
            var ratio = Math.max(Math.abs(dx) / (startW || 1), Math.abs(dy) / (startH || 1));
            if (ratio > 0.01) {
              var signX = dx >= 0 ? 1 : -1;
              var signY = dy >= 0 ? 1 : -1;
              if (Math.abs(dx) >= Math.abs(dy)) {
                newW = startW + signX * ratio * startW;
                newH = newW / aspect;
              } else {
                newH = startH + signY * ratio * startH;
                newW = newH * aspect;
              }
            }
          }
        }

        // Clamp
        newW = Math.max(minW, Math.round(newW));
        newH = Math.max(minH, Math.round(newH));

        img.style.width = newW + 'px';
        img.style.height = newH + 'px';
      }

      function onUp() {
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('mouseup', onUp);
        syncImageSize(img, url);
      }

      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup', onUp);
    });
  });
}

function syncImageSize(img,url){if(!url)return;var w=Math.round(img.offsetWidth);var h=Math.round(img.offsetHeight);imageSizes[url]={w:w,h:h}}

// Auto-preview after inserting image
function showPreviewAfterInsert() {
  if (!previewVisible) {
    previewVisible = true;
    const preview = document.getElementById('e-preview');
    const btn = document.getElementById('tb-preview-btn');
    btn.classList.add('active');
    textarea.style.display = 'none';
    preview.style.display = 'block';
  }
  renderPreview();
}

// ---- Form Submit ----
const isQuick = <%= isQuick ? 'true' : 'false' %>;
function toggleMeta() {
  var meta = document.getElementById('editor-meta');
  if (meta.style.display === 'none') {
    meta.style.display = 'flex';
  } else {
    meta.style.display = 'none';
  }
}

document.getElementById('editor-form').addEventListener('submit', async e => {
  e.preventDefault();
  const r = document.getElementById('editor-result');
  r.className = 'result';
  r.textContent = '保存中...';
  try {
    var title = document.getElementById('e-title').value.trim();
    var slug = document.getElementById('e-slug').value.trim();
    var type = document.getElementById('e-type').value;
    var tags = document.getElementById('e-tags').value;
    var content = document.getElementById('e-content').value;

    // Quick mode: auto-generate metadata
    if (isQuick && !title) {
      const resName = await fetch('/api/next-name?type=note');
      const d = await resName.json();
      title = d.name;
      slug = d.name.replace(/[^\w一-鿿]/g, '-').replace(/-+/g, '-');
      // Detect type from content
      if (/```(\w+)/.test(content)) {
        var m = content.match(/```(\w+)/);
        if (m) type = m[1].toLowerCase();
      }
    }
    if (!title) { r.className = 'result error'; r.textContent = '请输入标题'; return; }
    if (!slug) slug = title.replace(/[^\w一-鿿]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');

    const res = await fetch('/api/notes', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        title: title,
        slug: slug,
        content: content,
        type: type,
        tags: tags,
        imgSizes: imageSizes
      })
    });
    const data = await res.json();
    if (data.ok) {
      r.className = 'result success';
      r.innerHTML = '已保存！<a href="/note/' + encodeURIComponent(data.slug) + '">查看</a>';
      document.getElementById('e-slug').value = data.slug;
    } else {
      r.className = 'result error';
      r.textContent = data.error;
    }
  } catch (err) {
    r.className = 'result error';
    r.textContent = '保存失败：' + err.message;
  }
});

// Ctrl+S to save
document.addEventListener('keydown', function(e) {
  if ((e.ctrlKey || e.metaKey) && e.key === 's') {
    e.preventDefault();
    document.getElementById('editor-form').dispatchEvent(new Event('submit'));
  }
});
</script>

